+def _token_status(token, now=None):
+    if not token:
+        return 'none'
+    now = now or utcnow()
+    if token.revoked_at is not None:
+        return 'revoked'
+    if token.used_at is not None:
+        return 'used'
+    if token.expires_at and token.expires_at <= now:
+        return 'expired'
+    return 'pending'
+
+
+def _runtime_payload(node):
+    try:
+        runtime = json.loads(node.last_report_json or '{}')
+        return runtime if isinstance(runtime, dict) else {}
+    except Exception:
+        return {}
+
+
+def _node_payload(node, now=None, token=None):
+    now = now or utcnow()
+    age = (now - node.last_seen_at).total_seconds() if node.last_seen_at else None
+    ent = node_entitlement(node, now)
+    live_status = 'revoked' if node.revoked_at else (
+        ent['reason'] or ('online' if age is not None and age < 60 else 'offline')
+    )
+    return {
+        'id': node.id, 'node_id': node.id,
+        'representative_id': node.representative_id or node.id,
+        'bound_ip': node.bound_ip,
+        'name': node.name, 'hostname': node.hostname,
+        'panel_type': node.panel_type, 'panel_name': node.panel_name,
+        'panel_version': node.panel_version, 'agent_version': node.agent_version,
+        'wg_address': node.wg_address, 'status': live_status,
+        'panel_connected': bool(age is not None and age < 60 and node.revoked_at is None),
+        'license': ent, 'last_seen_at': node.last_seen_at,
+        'desired_location': node.desired_location,
+        'applied_location': node.applied_location,
+        'desired_revision': node.desired_revision,
+        'last_error': node.last_error, 'runtime': _runtime_payload(node),
+        'created_at': node.created_at,
+        'token': ({
+            'id': token.id, 'status': _token_status(token, now),
+            'issued_at': token.created_at, 'expires_at': token.expires_at,
