+@admin_router.post('/representatives/{representative_id}/web-login')
+def update_representative_web_login(representative_id: str, body: WebLoginUpdateRequest):
+    username = body.username.strip()
+    password_hash = hash_web_password(body.password)
+    now = utcnow()
+    with SessionLocal() as db:
+        token = db.scalar(
+            select(GanjEnrollmentToken)
+            .where(GanjEnrollmentToken.representative_id == representative_id)
+            .order_by(GanjEnrollmentToken.created_at.desc())
+            .with_for_update()
+        )
+        node = db.scalar(
+            select(GanjManagedNode)
+            .where(
+                GanjManagedNode.representative_id == representative_id,
+                GanjManagedNode.revoked_at.is_(None),
+            )
+            .order_by(GanjManagedNode.created_at.desc())
+            .with_for_update()
+        )
+        if token is None and node is None:
+            raise HTTPException(404, 'representative not found')
+
+        if token is not None:
+            token.web_username = username
+            token.web_password_hash = password_hash
+        command_id = None
+        if node is not None:
+            node.web_username = username
+            node.web_password_hash = password_hash
+            node.updated_at = now
+            queued = db.scalar(
+                select(GanjNodeCommand)
+                .where(
+                    GanjNodeCommand.node_id == node.id,
+                    GanjNodeCommand.action == 'web_credentials_set',
+                    GanjNodeCommand.status == 'queued',
+                )
+                .order_by(GanjNodeCommand.id.desc())
+                .with_for_update()
+            )
+            payload = safe_json({
+                'username': username,
+                'password_hash': password_hash,
+            })
+            if queued is not None:
+                queued.payload_json = payload
+                command_id = queued.id
+            else:
+                cmd = GanjNodeCommand(
+                    node_id=node.id,
+                    action='web_credentials_set',
+                    payload_json=payload,
+                    status='queued',
+                    created_at=now,
+                )
+                db.add(cmd)
+                db.flush()
+                command_id = cmd.id
+        db.commit()
+        return {
+            'ok': True,
+            'representative_id': representative_id,
+            'web_login': {'username': username, 'configured': True},
+            'command_id': command_id,
+            'delivery': 'queued' if command_id else 'on_enrollment',
+        }
+
+
